{% assign media_count = product.media.size %}
{% if is_ganja and media_count == 5 %}
  <div class="product-gallery" data-gallery="{{ product.id }}"><div class="product-media">{% assign first_media = product.media.first %}{{ first_media.preview_image | image_url: width: 900 | image_tag: class: 'gallery-main-image', alt: 'Four open Ganja Gadget items arranged on a dark textured surface.', widths: '320,480,640,900', sizes: '(min-width: 761px) 33vw, 100vw', loading: 'eager' }}</div><div class="gallery-controls" aria-label="Ganja Gadget image gallery">{% for media in product.media limit: 5 %}{% if forloop.first %}{% assign media_alt = 'Four open Ganja Gadget items arranged on a dark textured surface.' %}{% else %}{% assign media_alt = 'An open Ganja Gadget shown against a dark forest floor.' %}{% endif %}<button type="button" class="gallery-thumb{% if forloop.first %} is-current{% endif %}"{% if forloop.first %} aria-current="true"{% endif %} aria-label="Show image {{ forloop.index }} of 5 for Ganja Gadget" data-image-src="{{ media.preview_image | image_url: width: 900 }}" data-image-alt="{{ media_alt }}">{{ media.preview_image | image_url: width: 120 | image_tag: alt: '', widths: '44,88,120', loading: 'lazy' }}{% if forloop.first %}<span class="sr-only">Current image</span>{% endif %}</button>{% endfor %}</div><p class="sr-only gallery-announcement" aria-live="polite"></p></div>
{% elsif is_sleeve %}<div class="product-media product-media-sleeve">{{ product.featured_media.preview_image | image_url: width: 900 | image_tag: alt: 'A red spiky lighter sleeve fitted around a lighter on a dark forest floor.', widths: '320,480,640,900', sizes: '(min-width: 761px) 33vw, 100vw', loading: 'eager' }}</div>
{% else %}<div class="product-media">{{ product.featured_media.preview_image | image_url: width: 900 | image_tag: alt: product.title, widths: '320,480,640,900', sizes: '(min-width: 761px) 33vw, 100vw', loading: 'eager' }}</div>{% endif %}
