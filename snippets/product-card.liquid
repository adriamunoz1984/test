{% liquid
  assign is_dab_tools = product.title == 'Handmade Dab Tools'
  assign is_sleeve = product.title == 'Spiky Lighter Sleeve'
  assign is_ganja = product.title == 'Ganja Gadget'
%}
<article class="product-card{% if is_dab_tools %} product-card-no-image{% endif %}">
  {% if is_dab_tools %}<div class="product-media product-media-placeholder">Product image not yet available</div>
  {% elsif product.media.size > 0 %}{% render 'product-gallery', product: product, is_ganja: is_ganja, is_sleeve: is_sleeve %}
  {% else %}<div class="product-media product-media-placeholder">Product image not yet available</div>{% endif %}
  <h3>{{ product.title | escape }}</h3>
  {% if product.price_varies %}<p class="price">From {{ product.price_min | money }}</p>{% else %}<p class="price">{{ product.price | money }}</p>{% endif %}
  {% if product.description != blank %}<p class="product-description">{{ product.description | strip_html | escape }}</p>{% endif %}
</article>
