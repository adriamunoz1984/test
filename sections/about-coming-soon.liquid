<section id="about" class="collection section-light" aria-labelledby="about-title-{{ section.id }}" {{ section.shopify_attributes }}><div class="collection-art" aria-hidden="true"><span>MM</span></div><div class="collection-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="about-title-{{ section.id }}">{{ section.settings.heading | escape }} <em>{{ section.settings.emphasis | escape }}</em></h2><p>{{ section.settings.body | escape }}</p><div class="coming-soon"><p>{{ section.settings.coming_soon_label | escape }}</p><ul>{% for block in section.blocks %}<li {{ block.shopify_attributes }}>{{ block.settings.name | escape }}</li>{% endfor %}</ul></div></div></section>
{% schema %}{"name":"About and coming soon","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MUNOZ MINIZ"},{"type":"text","id":"heading","label":"Heading","default":"Products with"},{"type":"text","id":"emphasis","label":"Emphasized heading","default":"personality."},{"type":"textarea","id":"body","label":"Body","default":"Munoz Miniz offers 3D-printed products and custom work."},{"type":"text","id":"coming_soon_label","label":"Coming soon label","default":"Coming soon"}],"blocks":[{"type":"item","name":"Coming soon item","settings":[{"type":"text","id":"name","label":"Name","default":"Horror Character Products"}]}],"presets":[{"name":"About and coming soon","blocks":[{"type":"item"},{"type":"item"}]}]}{% endschema %}
