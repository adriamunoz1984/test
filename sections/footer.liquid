<footer {{ section.shopify_attributes }}><div class="footer-links"><a class="wordmark" href="#top" aria-label="Munoz Miniz home">MUNOZ <span>MINIZ</span></a><div><h3>Explore</h3>{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% else %}<a href="#products">Current products</a><a href="#custom">Custom work</a><a href="#about">About Munoz Miniz</a>{% endif %}</div></div><p class="copyright">{{ section.settings.copyright | escape }}</p></footer>
{% schema %}{"name":"Footer","settings":[{"type":"link_list","id":"menu","label":"Footer menu"},{"type":"text","id":"copyright","label":"Copyright text","default":"© 2026 Munoz Miniz"}],"presets":[{"name":"Footer"}]}{% endschema %}
