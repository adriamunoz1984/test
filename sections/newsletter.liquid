<section class="signup" aria-labelledby="signup-title-{{ section.id }}" {{ section.shopify_attributes }}><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="signup-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p></div><form class="newsletter-poc" novalidate><label for="email-{{ section.id }}">Email address</label><div class="email-row"><input id="email-{{ section.id }}" name="email" type="email" autocomplete="email" required placeholder="you@example.com"><button class="button primary" type="submit">{{ section.settings.button_label | escape }}</button></div><p class="form-message" aria-live="polite"></p></form></section>
{% schema %}{"name":"Newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"STAY IN THE LOOP"},{"type":"text","id":"heading","label":"Heading","default":"Stay in the loop"},{"type":"textarea","id":"body","label":"Body","default":"Get updates from Munoz Miniz."},{"type":"text","id":"button_label","label":"Button label","default":"Sign me up"}],"presets":[{"name":"Newsletter"}]}{% endschema %}
