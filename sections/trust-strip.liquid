<aside class="trust-strip" aria-label="Munoz Miniz process" {{ section.shopify_attributes }}>{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{{ block.settings.number | escape }} <span>{{ block.settings.text | escape }}</span></div>{% endfor %}</aside>
{% schema %}{"name":"Trust strip","max_blocks":3,"blocks":[{"type":"item","name":"Process item","settings":[{"type":"text","id":"number","label":"Number","default":"01"},{"type":"text","id":"text","label":"Text","default":"Current products"}]}],"presets":[{"name":"Trust strip","blocks":[{"type":"item"},{"type":"item"},{"type":"item"}]}]}{% endschema %}
