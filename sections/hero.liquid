<section id="top" class="hero" aria-labelledby="hero-title-{{ section.id }}" {{ section.shopify_attributes }}><div class="hero-copy"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1 id="hero-title-{{ section.id }}">{{ section.settings.heading | escape }} <em>{{ section.settings.emphasis | escape }}</em></h1><p class="lede">{{ section.settings.lede | escape }}</p><div class="actions"><a class="button primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a><a class="text-link" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">&rarr;</span></a></div></div><div class="hero-art" aria-hidden="true">{% if section.settings.desktop_image != blank or section.settings.mobile_image != blank %}<picture>{% if section.settings.desktop_image != blank %}<source media="(min-width: 761px)" srcset="{{ section.settings.desktop_image | image_url: width: 1800 }}">{% endif %}{% assign hero_image = section.settings.mobile_image | default: section.settings.desktop_image %}{{ hero_image | image_url: width: 1200 | image_tag: alt: '', widths: '480,750,960,1200,1800', sizes: '(min-width: 761px) 50vw, 100vw', loading: 'eager' }}</picture>{% endif %}</div></section>
{% schema %}{"name":"Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MUNOZ MINIZ · 3D-PRINTED PRODUCTS"},{"type":"text","id":"heading","label":"Heading","default":"Small prints."},{"type":"text","id":"emphasis","label":"Emphasized heading","default":"Big personality."},{"type":"textarea","id":"lede","label":"Lede","default":"Explore current 3D-printed products from Munoz Miniz, or start a custom-work conversation."},{"type":"text","id":"primary_label","label":"Primary button label","default":"Shop current products"},{"type":"url","id":"primary_link","label":"Primary button link","default":"#products"},{"type":"text","id":"secondary_label","label":"Secondary button label","default":"Custom work"},{"type":"url","id":"secondary_link","label":"Secondary button link","default":"#custom"},{"type":"image_picker","id":"desktop_image","label":"Desktop/tablet Hero 2 image"},{"type":"image_picker","id":"mobile_image","label":"Mobile Hero 2 image"}],"presets":[{"name":"Hero"}]}{% endschema %}
