<section id="{{ section.settings.anchor | default: 'products' | handleize }}" class="products section-dark" aria-labelledby="products-title-{{ section.id }}" {{ section.shopify_attributes }}><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="products-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div></div><div class="product-grid">{% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}{% else %}<p class="product-empty-state">Configure a featured collection with approved catalog products to preview this area.</p>{% endif %}</div><p class="catalog-note">{{ section.settings.catalog_note | escape }}</p></section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CURRENT LINEUP"},{"type":"text","id":"heading","label":"Heading","default":"Featured products"},{"type":"collection","id":"collection","label":"Featured collection"},{"type":"range","id":"limit","label":"Maximum product count","min":1,"max":3,"step":1,"default":3},{"type":"text","id":"catalog_note","label":"Catalog note","default":"Product details and checkout are not connected in this proof of concept."},{"type":"text","id":"anchor","label":"Section anchor","default":"products"}],"presets":[{"name":"Featured products"}]}{% endschema %}
