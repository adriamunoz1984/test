<section id="custom" class="custom section-dark" aria-labelledby="custom-title-{{ section.id }}" {{ section.shopify_attributes }}><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="custom-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p><button class="button primary" type="button" data-notice="Custom-work inquiries are not connected in this proof of concept.">{{ section.settings.button_label | escape }}</button></section>
{% schema %}{"name":"Custom work","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CUSTOM WORK"},{"type":"text","id":"heading","label":"Heading","default":"Have a custom idea?"},{"type":"textarea","id":"body","label":"Body","default":"Share your reference, preferred size, color, and intended use. Munoz Miniz will review the request before confirming availability and pricing."},{"type":"text","id":"button_label","label":"Button label","default":"Start a custom-work inquiry"}],"presets":[{"name":"Custom work"}]}{% endschema %}
